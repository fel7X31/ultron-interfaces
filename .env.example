# Copie este arquivo para .env e preencha.

# Pasta que o Claude Code abre (seu segundo cérebro, vault ou projeto)
ULTRON_PASTA=~/Documentos/meu-vault

# ElevenLabs: voz da resposta (e transcrição, se você não tiver whisper local)
ELEVENLABS_API_KEY=
# ID da voz. Escolha na Voice Library, clique em "Add to my voices" e copie o ID.
ULTRON_VOZ=xHUwLsLfyqiYOIVTzLRW
# eleven_multilingual_v2 = melhor som | eleven_flash_v2_5 = começa a falar mais rápido
ULTRON_MODELO_VOZ=eleven_multilingual_v2
# Velocidade da fala: 1.0 normal (de 0.7 a 1.2)
ULTRON_VELOCIDADE_VOZ=1.0

# Transcrição: auto (tenta o whisper local e cai pro ElevenLabs) | whisper | elevenlabs
ULTRON_TRANSCRICAO=auto
WHISPER_URL=http://127.0.0.1:8178

# Modelo do Claude: sonnet (mais rápido) | opus (mais caprichado) | haiku. Também troca na engrenagem ou por voz ("usa o Opus")
ULTRON_MODELO=sonnet
# O esforço de cada modelo (o quanto ele pensa) se escolhe na tela, na lista de IAs. Sem escolha: o padrão do modelo.
# leve = abre numa pasta vazia com a sua pasta anexada (responde em ~1 s) | completo = abre direto na sua pasta (carrega o CLAUDE.md dela; bom pra pasta pequena)
ULTRON_CONTEXTO=leve
# Arquivo de persona (troque pra ter um modo diferente, ex.: persona-video.md)
ULTRON_PERSONA=persona.md

# Ferramentas que o Ultron não pode usar (separadas por vírgula)
ULTRON_BLOQUEAR_FERRAMENTAS=

# Atalhos lentos que rodam quando ele abre (separe por ;). Ex.: isca_resumo.py --dia ontem
ULTRON_AQUECER_ATALHOS=

ULTRON_PORTA=8790

# Como ele te chama (dá pra mudar depois na engrenagem da tela)
ULTRON_NOME=Chefe

# Painéis de e-mail e agenda: consulta ao Claude a cada N minutos (gasta do plano). 0 = desliga
ULTRON_PAINEIS_MIN=15
# 1 = manda uma mensagem curta ao abrir, pra primeira resposta já sair rápida
ULTRON_AQUECER=1

# Fish Audio (opcional): vozes com "provedor": "fish" no vozes.json falam por lá
FISH_API_KEY=
FISH_MODELO=s1
# Tom da fala no Fish Audio, ex.: (confident) (sarcastic)
FISH_TOM=

# Barra do topo da tela (barra.py, Windows): 1 = abre junto com o Ultron, 0 = desliga
ULTRON_BARRA=1

# Dizer "Ultron" faz ele ouvir o pedido (palmas.py, Windows): 1 = liga, 0 = desliga. Também muda na barra.
ULTRON_CHAMADO=1

# Pedir "Confirma?" antes de apagar, enviar mensagem, publicar, mexer na agenda ou desligar o PC: 0 = não (você
# autoriza tudo), 1 = sim. A trava e o .env o Ultron nunca muda, de qualquer jeito.
ULTRON_CONFIRMAR=0

# Outras IAs (opcional): com a chave, aparecem pra escolher no chip do topo da tela ou por voz ("usa o Gemini").
# Sem chave, o Gemini e o ChatGPT também entram pela sua conta (botão "Entrar" no chip; veja o README).
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
# Modelo de cada uma (vazio = o padrão de ultron/recursos/ias.py)
ULTRON_MODELO_CHATGPT=
ULTRON_MODELO_GEMINI=
ULTRON_MODELO_GROK=
